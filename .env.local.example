# Copy this file to .env.local, then fill in these two values from
# Supabase: Project Settings -> API.
NEXT_PUBLIC_DRAFTCENTER_SUPABASE_URL=
NEXT_PUBLIC_DRAFTCENTER_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCORD_INSTALL_URL=
NEXT_PUBLIC_DRAFTCENTER_RELEASE=
NEXT_PUBLIC_TOURNAMENTS_ENABLED=false
NEXT_PUBLIC_MATCH_SCHEDULING_ENABLED=false

# Discord sign-in is configured in Supabase Authentication -> Providers.
# Allow http://localhost:3000/auth/callback and each deployed callback URL
# under Supabase Authentication -> URL Configuration.

# Server-only values: add these only in Vercel, never to GitHub or browser code.
DRAFTCENTER_SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DRAFTCENTER_SITE_URL=http://localhost:3000
