# Copy this file to .env.local, then fill in these two values from
# Supabase: Project Settings -> API.
NEXT_PUBLIC_DRAFTCENTER_SUPABASE_URL=
NEXT_PUBLIC_DRAFTCENTER_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCORD_INSTALL_URL=
# Public Cloudflare Turnstile widget key. The matching secret belongs only in
# Supabase Auth -> Bot and Abuse Protection, never in this file or Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only values: add these only in Vercel, never to GitHub or browser code.
DRAFTCENTER_SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Comma-separated owner accounts. These emails can open /operations and receive owner alerts.
DRAFTCENTER_OWNER_EMAILS=
DISCORD_BOT_TOKEN=
DISCORD_COMMUNITY_GUILD_ID=

# Twitch automatic Live Now detection. Create these in the Twitch Developer Console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://www.draftcentral.gg/api/twitch/eventsub
